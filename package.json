{
  "name": "nature-chronicles-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "build": "nest build",
    "start": "pnpm db:generate && pnpm db:deploy && nest start",
